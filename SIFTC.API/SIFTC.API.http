@SIFTC.API_HostAddress = http://localhost:5057
@token = <pegar el token devuelto por /auth/login>

POST {{SIFTC.API_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "",
  "password": ""
}

###

GET {{SIFTC.API_HostAddress}}/api/v1/entidades?sector=Energía&sort=ic&dir=desc&page=1&size=20
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{SIFTC.API_HostAddress}}/api/v1/entidades/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
Accept: application/json

###
